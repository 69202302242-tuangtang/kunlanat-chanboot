                epiCurve: [1200, 1500, 1800, 2400, 3100, 4200, 5800, 7500, 8900, 9400, 8800, 7200, 6100, 5000, 4200, 3500],
                medianCurve: [1000, 1200, 1400, 1800, 2200, 2800, 3500, 4200, 5000, 5200, 4800, 4000, 3200, 2800, 2200, 1800],
                topAreas: [
                    { name: 'กรุงเทพมหานคร', rate: 245.0 },
                    { name: 'เชียงใหม่', rate: 210.8 },
                    { name: 'นนทบุรี', rate: 195.4 },
                    { name: 'ชลบุรี', rate: 182.1 },
                    { name: 'นครราชสีมา', rate: 165.0 }
                ],
                locations: [
                    { name: 'กรุงเทพฯ (เขตจตุจักร)', region: 'r13', lat: 13.8033, lng: 100.5538, cases: 12100, deaths: 3, pop: 493000, trend: 'up', alert: 'Red' },
                    { name: 'เชียงใหม่ (อ.เมือง)', region: 'r1', lat: 18.7883, lng: 98.9853, cases: 3580, deaths: 1, pop: 170000, trend: 'up', alert: 'Red' },
                    { name: 'นนทบุรี (อ.เมือง)', region: 'r4', lat: 13.8591, lng: 100.5217, cases: 5200, deaths: 1, pop: 266000, trend: 'up', alert: 'Red' },
                    { name: 'ชลบุรี (อ.เมือง)', region: 'r4', lat: 13.3611, lng: 100.9847, cases: 4100, deaths: 1, pop: 225000, trend: 'stable', alert: 'Orange' },
                    { name: 'อุดรธานี (อ.เมือง)', region: 'r8', lat: 17.4138, lng: 102.7872, cases: 2450, deaths: 0, pop: 171000, trend: 'up', alert: 'Orange' },
                    { name: 'นครราชสีมา (อ.เมือง)', region: 'r8', lat: 14.9799, lng: 102.0978, cases: 4290, deaths: 1, pop: 260000, trend: 'stable', alert: 'Orange' },
                    { name: 'สงขลา (อ.หาดใหญ่)', region: 'r11', lat: 7.0084, lng: 100.4767, cases: 3200, deaths: 0, pop: 300000, trend: 'down', alert: 'Yellow' },
                    { name: 'ภูเก็ต (อ.เมือง)', region: 'r11', lat: 7.8804, lng: 98.3923, cases: 1450, deaths: 0, pop: 115000, trend: 'stable', alert: 'Yellow' }
                ]
            },
            hfmd: {
                name: 'โรคมือ เท้า ปาก (HFMD)',
                totalCases: 29400,
                incidenceRate: 44.3,
                deaths: 1,
                cfr: '0.003%',
                highRiskCount: 5,
                note: 'เฝ้าระวังเชื้อ Enterovirus 71 (EV71) ในศูนย์พัฒนาเด็กเล็กและโรงเรียนอนุบาล เน้นมาตรการคัดกรองและล้างมือ',
                epiCurve: [250, 310, 420, 550, 780, 950, 1250, 1600, 1850, 1700, 1400, 1150, 900, 750, 600, 480],
                medianCurve: [200, 250, 300, 400, 500, 650, 800, 1000, 1100, 1050, 900, 750, 600, 500, 400, 300],
                topAreas: [
                    { name: 'สมุทรปราการ', rate: 88.5 },
                    { name: 'ปทุมธานี', rate: 76.2 },
                    { name: 'กรุงเทพมหานคร', rate: 68.4 },
                    { name: 'เชียงใหม่', rate: 52.0 },
                    { name: 'อุดรธานี', rate: 45.1 }
                ],
                locations: [
                    { name: 'สมุทรปราการ (อ.เมือง)', region: 'r4', lat: 13.5991, lng: 100.5968, cases: 1820, deaths: 0, pop: 205000, trend: 'up', alert: 'Orange' },
                    { name: 'ปทุมธานี (อ.คลองหลวง)', region: 'r4', lat: 14.0652, lng: 100.6464, cases: 1650, deaths: 0, pop: 216000, trend: 'up', alert: 'Orange' },
                    { name: 'กรุงเทพฯ (เขตจตุจักร)', region: 'r13', lat: 13.8033, lng: 100.5538, cases: 3370, deaths: 1, pop: 493000, trend: 'stable', alert: 'Orange' },
                    { name: 'เชียงใหม่ (อ.เมือง)', region: 'r1', lat: 18.7883, lng: 98.9853, cases: 884, deaths: 0, pop: 170000, trend: 'down', alert: 'Yellow' },
                    { name: 'อุดรธานี (อ.เมือง)', region: 'r8', lat: 17.4138, lng: 102.7872, cases: 770, deaths: 0, pop: 171000, trend: 'stable', alert: 'Yellow' }
                ]
            },
            covid: {
                name: 'โรค COVID-19',
                totalCases: 86100,
                incidenceRate: 129.9,
                deaths: 142,
                cfr: '0.16%',
                highRiskCount: 9,
                note: 'พบสายพันธุ์ย่อยใหม่ มีการกระจายตัวสูงในกลุ่มผู้สูงอายุ 608 แนะนำการฉีดวัคซีนเข็มกระตุ้นในกลุ่มเสี่ยงสูง',
                epiCurve: [1500, 1800, 2200, 2900, 3800, 4500, 5200, 5900, 5600, 4900, 4100, 3400, 2800, 2300, 1900, 1600],
                medianCurve: [1200, 1400, 1700, 2100, 2600, 3000, 3400, 3800, 3600, 3200, 2700, 2200, 1800, 1500, 1200, 1000],
                topAreas: [
                    { name: 'กรุงเทพมหานคร', rate: 198.5 },
                    { name: 'นนทบุรี', rate: 162.0 },
                    { name: 'ภูเก็ต', rate: 145.2 },
                    { name: 'ชลบุรี', rate: 138.9 },
                    { name: 'เชียงใหม่', rate: 120.4 }
                ],
                locations: [
                    { name: 'กรุงเทพฯ (เขตจตุจักร)', region: 'r13', lat: 13.8033, lng: 100.5538, cases: 9780, deaths: 28, pop: 493000, trend: 'stable', alert: 'Orange' },
                    { name: 'นนทบุรี (อ.เมือง)', region: 'r4', lat: 13.8591, lng: 100.5217, cases: 4310, deaths: 12, pop: 266000, trend: 'down', alert: 'Yellow' },
                    { name: 'ภูเก็ต (อ.เมือง)', region: 'r11', lat: 7.8804, lng: 98.3923, cases: 1670, deaths: 3, pop: 115000, trend: 'stable', alert: 'Yellow' },
                    { name: 'ชลบุรี (อ.บางละมุง)', region: 'r4', lat: 12.9276, lng: 100.8771, cases: 3330, deaths: 8, pop: 240000, trend: 'down', alert: 'Yellow' },
                    { name: 'เชียงใหม่ (อ.เมือง)', region: 'r1', lat: 18.7883, lng: 98.9853, cases: 2040, deaths: 5, pop: 170000, trend: 'down', alert: 'Yellow' }
                ]
            }
        };

        // Map & Chart Instances
        let map;
        let mapMarkersLayer = L.layerGroup();
        let heatLayer = null;
        let mapMode = 'bubbles'; // 'bubbles' or 'heatmap'

        let epiChartInstance = null;
        let demoChartInstance = null;
        let topAreasChartInstance = null;

        function initMap() {
            // Center of Thailand
            map = L.map('map', {
                center: [13.7563, 100.5018],
                zoom: 6,
                zoomControl: true
            });

            // ESRI World Dark Gray Canvas Base Tile Layer
            const esriDarkCanvas = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ, HERE, iPC',
                maxZoom: 16,
                minZoom: 5
            }).addTo(map);

            // ESRI Dark Gray Reference Labels Overlay (Optional text labels)
            const esriLabels = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Esri Reference',
                maxZoom: 16,
                minZoom: 5,
                opacity: 0.75
            }).addTo(map);

            mapMarkersLayer.addTo(map);
        }

        function getColorByRate(rate) {
            if (rate >= 100) return '#ef4444'; // Red
            if (rate >= 50) return '#f97316';  // Orange
            if (rate >= 15) return '#facc15';  // Yellow
            return '#10b981';                  // Green
        }

        function getAlertBadgeHTML(alert) {
            switch(alert) {
                case 'Red':
                    return `<span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-rose-950 text-rose-300 border border-rose-700/60"><i class="fa-solid fa-circle-exclamation mr-1"></i> สีแดง (ระบาดสูง)</span>`;
                case 'Orange':
                    return `<span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-orange-950 text-orange-300 border border-orange-700/60"><i class="fa-solid fa-triangle-exclamation mr-1"></i> สีส้ม (เฝ้าระวัง)</span>`;
                case 'Yellow':
                    return `<span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-amber-950 text-amber-300 border border-amber-700/60"><i class="fa-solid fa-circle-info mr-1"></i> สีเหลือง (ปกติ)</span>`;
                default:
                    return `<span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-950 text-emerald-300 border border-emerald-700/60"><i class="fa-solid fa-check mr-1"></i> สีเขียว (ต่ำ)</span>`;
            }
        }

        function getTrendIconHTML(trend) {
            if (trend === 'up') return `<span class="text-rose-400 font-bold"><i class="fa-solid fa-arrow-up-right"></i> เพิ่มขึ้น</span>`;
            if (trend === 'down') return `<span class="text-emerald-400 font-bold"><i class="fa-solid fa-arrow-down-right"></i> ลดลง</span>`;
            return `<span class="text-amber-400 font-bold"><i class="fa-solid fa-minus"></i> คงที่</span>`;
        }

        function renderMapLayers(locations) {
            mapMarkersLayer.clearLayers();

            if (heatLayer) {
                map.removeLayer(heatLayer);
                heatLayer = null;
            }

            const heatPoints = [];

            locations.forEach(loc => {
                const rate = ((loc.cases / loc.pop) * 100000).toFixed(1);
                const color = getColorByRate(rate);

                // Calculate radius based on case count
                const radius = Math.min(Math.max(loc.cases / 80, 8), 28);

                // Add to heatmap points array
                heatPoints.push([loc.lat, loc.lng, Math.min(rate / 150, 1.0)]);

                if (mapMode === 'bubbles') {
                    // Create Custom Circle Marker with glowing style
                    const circle = L.circleMarker([loc.lat, loc.lng], {
                        radius: radius,
                        fillColor: color,
                        color: color,
                        weight: rate >= 100 ? 3 : 1.5,
                        opacity: 0.9,
                        fillOpacity: 0.55
                    });

                    // Interactive Popup with detailed public health info
                    const popupContent = `
                        <div class="font-sans text-xs">
                            <div class="flex items-center justify-between gap-2 border-b border-slate-700 pb-1.5 mb-2">
                                <h4 class="font-bold text-sm text-white">${loc.name}</h4>
                                ${getAlertBadgeHTML(loc.alert)}
                            </div>
                            <div class="space-y-1 text-slate-300">
                                <p><span class="text-slate-400">ผู้ป่วยสะสม:</span> <strong class="text-white">${loc.cases.toLocaleString()} ราย</strong></p>
                                <p><span class="text-slate-400">อัตราป่วย:</span> <strong class="text-amber-400">${rate}</strong> ต่อแสนประชากร</p>
                                <p><span class="text-slate-400">ผู้เสียชีวิต:</span> <strong class="text-rose-400">${loc.deaths} ราย</strong></p>
                                <p><span class="text-slate-400">แนวโน้ม:</span> ${getTrendIconHTML(loc.trend)}</p>
                            </div>
                            <div class="mt-2 pt-1.5 border-t border-slate-800 text-[11px] text-slate-400 flex justify-between">
                                <span>ประชากร: ${(loc.pop/1000).toFixed(1)}k คน</span>
                                <span class="text-teal-400 cursor-pointer hover:underline" onclick="zoomToLocation(${loc.lat}, ${loc.lng})">ซูมเข้า</span>
                            </div>
                        </div>
                    `;

                    circle.bindPopup(popupContent);
                    mapMarkersLayer.addLayer(circle);
                }
            });

            if (mapMode === 'heatmap') {
                heatLayer = L.heatLayer(heatPoints, {
                    radius: 30,
                    blur: 20,
                    maxZoom: 10,
                    gradient: { 0.2: '#10b981', 0.4: '#facc15', 0.7: '#f97316', 1.0: '#ef4444' }
                }).addTo(map);
            }
        }

        function toggleMapMode(mode) {
            mapMode = mode;
            document.getElementById('btnBubbles').className = mode === 'bubbles' 
                ? 'px-2.5 py-1 rounded-md bg-teal-600 text-white font-medium shadow-sm' 
                : 'px-2.5 py-1 rounded-md text-slate-300 hover:text-white hover:bg-slate-700 transition';
            document.getElementById('btnHeatmap').className = mode === 'heatmap' 
                ? 'px-2.5 py-1 rounded-md bg-teal-600 text-white font-medium shadow-sm' 
                : 'px-2.5 py-1 rounded-md text-slate-300 hover:text-white hover:bg-slate-700 transition';

            const currentDisease = document.getElementById('diseaseSelect').value;
            renderMapLayers(diseaseDatasets[currentDisease].locations);
        }

        function zoomToLocation(lat, lng) {
            map.setView([lat, lng], 11, { animate: true });
        }

        function renderEpiCurveChart(diseaseData) {
            const ctx = document.getElementById('epiCurveChart').getContext('2d');
            const weeks = Array.from({length: 16}, (_, i) => `สัปดาห์ ${i + 24}`);

            if (epiChartInstance) epiChartInstance.destroy();

            epiChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: weeks,
                    datasets: [
                        {
                            label: 'จำนวนผู้ป่วยจริง (ปี 2026)',
                            data: diseaseData.epiCurve,
                            borderColor: '#14b8a6',
                            backgroundColor: 'rgba(20, 184, 166, 0.15)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2.5,
                            pointRadius: 3,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'ค่ามัธยฐาน 5 ปีย้อนหลัง (Median)',
                            data: diseaseData.medianCurve,
                            borderColor: '#94a3b8',
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#cbd5e1', font: { family: 'Sarabun', size: 11 } }
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: '#1e293b',
                            titleColor: '#f8fafc',
                            bodyColor: '#cbd5e1',
                            borderColor: '#334155',
                            borderWidth: 1
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#94a3b8', font: { size: 10 } },
                            grid: { color: 'rgba(51, 65, 85, 0.3)' }
                        },
                        y: {
                            ticks: { color: '#94a3b8', font: { size: 10 } },
                            grid: { color: 'rgba(51, 65, 85, 0.3)' }
                        }
                    }
                }
            });
        }

        function renderDemographicsChart() {
            const ctx = document.getElementById('demographicsChart').getContext('2d');

            if (demoChartInstance) demoChartInstance.destroy();

            demoChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['0-4 ปี', '5-14 ปี', '15-24 ปี', '25-34 ปี', '35-59 ปี', '60+ ปี'],
                    datasets: [
                        {
                            label: 'ชาย (Male)',
                            data: [3200, 8400, 4100, 3100, 2800, 1500],
                            backgroundColor: 'rgba(56, 189, 248, 0.8)',
                            borderRadius: 4
                        },
                        {
                            label: 'หญิง (Female)',
                            data: [2900, 7800, 4300, 3400, 3100, 1800],
                            backgroundColor: 'rgba(244, 114, 182, 0.8)',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#cbd5e1', font: { family: 'Sarabun', size: 11 } }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#94a3b8', font: { size: 10 } },
                            grid: { color: 'rgba(51, 65, 85, 0.3)' }
                        },
                        y: {
                            ticks: { color: '#94a3b8', font: { size: 10 } },
                            grid: { color: 'rgba(51, 65, 85, 0.3)' }
                        }
                    }
                }
            });
        }

        function renderTopAreasChart(topAreas) {
            const ctx = document.getElementById('topAreasChart').getContext('2d');

            if (topAreasChartInstance) topAreasChartInstance.destroy();

            topAreasChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: topAreas.map(a => a.name),
                    datasets: [{
                        label: 'อัตราป่วยต่อแสนประชากร',
                        data: topAreas.map(a => a.rate),
                        backgroundColor: [
                            'rgba(239, 68, 68, 0.85)',
                            'rgba(249, 115, 22, 0.85)',
                            'rgba(245, 158, 11, 0.85)',
                            'rgba(20, 184, 166, 0.85)',
                            'rgba(59, 130, 246, 0.85)'
                        ],
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#94a3b8', font: { size: 10 } },
                            grid: { color: 'rgba(51, 65, 85, 0.3)' }
                        },
                        y: {
                            ticks: { color: '#cbd5e1', font: { family: 'Sarabun', size: 11 } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function renderTable(locations) {
            const tbody = document.getElementById('surveillanceTableBody');
            tbody.innerHTML = '';

            document.getElementById('tableRecordCount').textContent = locations.length;

            locations.forEach((loc) => {
                const rate = ((loc.cases / loc.pop) * 100000).toFixed(1);
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/60 transition text-xs border-b border-slate-800/60';

                tr.innerHTML = `
                    <td class="px-4 py-3 font-semibold text-white flex items-center space-x-2">
                        <i class="fa-solid fa-location-dot text-slate-500"></i>
                        <span>${loc.name}</span>
                    </td>
                    <td class="px-4 py-3 text-slate-400">เขต ${loc.region.replace('r', '')}</td>
                    <td class="px-4 py-3 text-right font-medium text-slate-200">${loc.cases.toLocaleString()}</td>
                    <td class="px-4 py-3 text-right text-rose-400 font-medium">${loc.deaths}</td>
                    <td class="px-4 py-3 text-right font-bold" style="color: ${getColorByRate(rate)}">${rate}</td>
                    <td class="px-4 py-3 text-center">${getTrendIconHTML(loc.trend)}</td>
                    <td class="px-4 py-3 text-center">${getAlertBadgeHTML(loc.alert)}</td>
                    <td class="px-4 py-3 text-center">
                        <button onclick="zoomToLocation(${loc.lat}, ${loc.lng})" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-teal-300 rounded border border-slate-700 transition">
                            <i class="fa-solid fa-crosshairs mr-1"></i> เล็งแผนที่
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateDashboard() {
            const selectedDiseaseKey = document.getElementById('diseaseSelect').value;
            const diseaseData = diseaseDatasets[selectedDiseaseKey];

            // Filter locations by region if needed
            const selectedRegion = document.getElementById('regionSelect').value;
            let filteredLocations = diseaseData.locations;
            if (selectedRegion !== 'all') {
                filteredLocations = diseaseData.locations.filter(loc => loc.region === selectedRegion);
            }

            // Update KPI Cards
            document.getElementById('kpiTotalCases').textContent = diseaseData.totalCases.toLocaleString();
            document.getElementById('kpiIncidenceRate').textContent = diseaseData.incidenceRate;
            document.getElementById('kpiDeaths').textContent = diseaseData.deaths;
            document.getElementById('kpiCFR').textContent = `CFR ${diseaseData.cfr}`;
            document.getElementById('kpiHighRiskAreas').textContent = diseaseData.highRiskCount;
            document.getElementById('epiAnalysisNote').textContent = diseaseData.note;

            // Update Visualizations
            renderMapLayers(filteredLocations);
            renderEpiCurveChart(diseaseData);
            renderDemographicsChart();
            renderTopAreasChart(diseaseData.topAreas);
            renderTable(filteredLocations);
        }

        function filterTableAndMap() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const selectedDiseaseKey = document.getElementById('diseaseSelect').value;
            const diseaseData = diseaseDatasets[selectedDiseaseKey];

            const filtered = diseaseData.locations.filter(loc => loc.name.toLowerCase().includes(query));
            renderTable(filtered);
            renderMapLayers(filtered);
        }

        function exportToCSV() {
            const selectedDiseaseKey = document.getElementById('diseaseSelect').value;
            const diseaseData = diseaseDatasets[selectedDiseaseKey];

            let csvContent = "data:text/csv;charset=utf-8,\uFEFF";
            csvContent += "จังหวัด/อำเภอ,เขตสุขภาพ,จำนวนผู้ป่วย,ผู้เสียชีวิต,ประชากร,อัตราป่วยต่อแสน,ระดับเตือนภัย\n";

            diseaseData.locations.forEach(loc => {
                const rate = ((loc.cases / loc.pop) * 100000).toFixed(1);
                csvContent += `"${loc.name}","${loc.region}",${loc.cases},${loc.deaths},${loc.pop},${rate},"${loc.alert}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `epidemiology_report_${selectedDiseaseKey}_2026.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        window.addEventListener('DOMContentLoaded', () => {
            initMap();
            updateDashboard();
        });
    </script>
</body>
</html>
